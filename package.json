{
  "name": "aivocode",
  "version": "1.0.1",
  "description": "AivoCode (aivo) v1.0 — AI Coding Studio & Native CLI Coding Agent for AivoKey",
  "type": "module",
  "homepage": "https://aivokey.dev/cli",
  "license": "MIT",
  "keywords": [
    "aivo",
    "aivocode",
    "aivokey",
    "coding-agent",
