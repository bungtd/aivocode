{
  "name": "@aivokey/cli",
  "version": "0.1.0",
  "description": "AivoCode — Native CLI Coding Harness purpose-built for AivoKey",
  "type": "module",
  "bin": {
    "aivo": "./dist/bin.js",
    "aivocode": "./dist/bin.js"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "node --import tsx src/bin.ts",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@types/node": "^24.3.1",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
